# Research-specific defaults; scripts/lab reads this only for GR00T / G1 commands.
POLICY_MODEL_PATH=${POLICY_MODEL_PATH:-/data/models/arena-g1/checkpoint-20000}
POLICY_PORT=${POLICY_PORT:-5555}
G1_POLICY_CONFIG=isaaclab_arena_gr00t/policy/config/g1_locomanip_gr00t_closedloop_config.yaml
G1_TASK=galileo_g1_locomanip_pick_and_place
G1_EMBODIMENT=g1_wbc_joint
# Recording run: same scene and policy, plus a fixed third-person camera (ws/src/simulation).
G1_RECORDING_ENV=robotics_lab_sim.g1_recording:G1RecordingEnvironment
G1_RECORDING_TASK=g1_locomanip_recording
G1_RECORDING_EMBODIMENT=g1_wbc_joint_recording

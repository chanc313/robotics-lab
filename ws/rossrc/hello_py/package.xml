<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hello_py</name>
  <version>0.1.0</version>
  <description>ROS 2 sandbox: a Python listener for /hello and a launch file that pairs it with hello_cpp.</description>
  <maintainer email="hjchanc313@gmail.com">Channing</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>hello_cpp</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

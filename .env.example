# Host identity: scripts/lab prepare writes these from id when .env is absent.
LOCAL_UID=1000
LOCAL_GID=1000
ROS_DOMAIN_ID=0
# Uncomment only after you have personally accepted the Isaac Sim license.
# OMNI_KIT_ACCEPT_EULA=YES
# ACCEPT_EULA=Y

# ROS middleware for dev and the Isaac bridge (defaults shown). Cyclone DDS also
# needs ros-jazzy-rmw-cyclonedds-cpp in the dev image; Isaac already bundles it.
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Local builds use robotics-lab-<service>. Published deployment uses a registry prefix.
# IMAGE_PREFIX=ghcr.io/chanc313/robotics-lab
# IMAGE_TAG=v0.1.0

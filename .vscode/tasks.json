{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: configure",
      "type": "cmake",
      "command": "configure",
      "problemMatcher": []
    },
    {
      "label": "C++: build",
      "type": "cmake",
      "command": "build",
      "targets": [
        "main"
      ],
      "dependsOn": "C++: configure",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Python: lint",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "ruff",
        "check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}

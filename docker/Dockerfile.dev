# syntax=docker/dockerfile:1
# check=skip=InvalidDefaultArgInFrom
# Base images are pinned once in compose.yaml (x-build-args), hence no ARG defaults.
ARG UV_IMAGE
ARG UBUNTU_IMAGE
FROM ${UV_IMAGE} AS uv
FROM ${UBUNTU_IMAGE} AS dev

ARG DEBIAN_FRONTEND=noninteractive
ARG LLVM_VERSION=20
ARG LOCAL_UID=1000
ARG LOCAL_GID=1000

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=jazzy

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential cmake ninja-build gdb pkg-config \
    python3 python3-venv python3-dev \
    clang-${LLVM_VERSION} libc++-${LLVM_VERSION}-dev libc++abi-${LLVM_VERSION}-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/

# Jazzy binary packages target Ubuntu Noble. Pin and verify the official apt-source bootstrap.
# RViz shares this image; display and GPU mounts come from compose.gui.yaml on demand.
RUN . /etc/os-release && test "${VERSION_CODENAME}" = noble \
    && curl --fail --location --retry 3 \
       https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.3.0/ros2-apt-source_1.3.0.noble_all.deb \
       --output /tmp/ros2-apt-source.deb \
    && printf '%s\n' 'f31d84adf5054c7d60ded0e82c0f776a77ea33af53d08f40b9ad7c94cca55296  /tmp/ros2-apt-source.deb' | sha256sum --check - \
    && dpkg -i /tmp/ros2-apt-source.deb \
    && apt-get update && apt-get install -y --no-install-recommends \
       ros-jazzy-ros-base ros-dev-tools \
       ros-jazzy-demo-nodes-cpp ros-jazzy-demo-nodes-py ros-jazzy-rviz2 \
       python3-debugpy libgl1 libegl1 \
    && rm -f /tmp/ros2-apt-source.deb \
    && rm -rf /var/lib/apt/lists/* \
    && rosdep init

# Robotics stack for the personal learning track, installed ahead of project use:
# ros2_control and the standard controllers; the MuJoCo hardware plugin with its demos
# (mujoco_vendor ships MuJoCo 3.12.0; the learning env pins the matching Python bindings);
# MoveIt 2 with the Panda demo config; and the Nav2 core. nav2_bringup is left out because
# it pulls in Gazebo, which this project does not use.
RUN apt-get update && apt-get install -y --no-install-recommends \
       ros-jazzy-ros2-control ros-jazzy-ros2-controllers \
       ros-jazzy-mujoco-ros2-control ros-jazzy-mujoco-ros2-control-demos \
       ros-jazzy-moveit ros-jazzy-moveit-resources-panda-moveit-config \
       ros-jazzy-navigation2 \
    && rm -rf /var/lib/apt/lists/*

# Reuse an existing group when the requested GID is already allocated.
RUN if id ubuntu >/dev/null 2>&1; then userdel -r ubuntu; fi \
    && if ! getent group "${LOCAL_GID}" >/dev/null; then groupadd --gid "${LOCAL_GID}" dev; fi \
    && useradd --uid "${LOCAL_UID}" --gid "${LOCAL_GID}" --create-home --shell /bin/bash dev \
    && mkdir -p /workspace /build /opt/learning /opt/learning-venv \
    && printf '%s\n' 'source /opt/ros/jazzy/setup.bash' >> /home/dev/.bashrc \
    && chown dev:"${LOCAL_GID}" /workspace /build /opt/learning /opt/learning-venv

COPY --chmod=755 docker/ros_entrypoint.sh /usr/local/bin/ros_entrypoint.sh

# Learning sandbox: dependencies are installed here, never at runtime. Its source stays
# bind-mounted; the .pth entry makes /workspace/pythonsrc importable without an install.
# The venv is kept off PATH so `python3` stays the system Python that rclpy needs.
ENV UV_PROJECT_ENVIRONMENT=/opt/learning-venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy
USER dev
COPY --chown=dev ws/pythonsrc/pyproject.toml ws/pythonsrc/uv.lock /opt/learning/
RUN uv sync --project /opt/learning --locked --all-extras --no-install-project --no-cache \
    && site_packages=$(/opt/learning-venv/bin/python -c 'import sysconfig; print(sysconfig.get_path("purelib"))') \
    && printf '%s\n' /workspace/pythonsrc > "$site_packages/robotics_lab_source.pth"

ENV CC=clang-${LLVM_VERSION} \
    CXX=clang++-${LLVM_VERSION} \
    DEBUGGER=gdb \
    UV_PROJECT=/workspace/pythonsrc \
    UV_NO_SYNC=1
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/ros_entrypoint.sh"]
CMD ["bash"]

{
  "name": "Robotics lab policy (GR00T)",
  "dockerComposeFile": [
    "../../compose.yaml",
    "../compose.devcontainer.yaml"
  ],
  "service": "policy",
  "runServices": [
    "policy"
  ],
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  "shutdownAction": "none",
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "initializeCommand": "./scripts/lab prepare",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ]
    }
  }
}

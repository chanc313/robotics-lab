{
  "name": "Robotics lab dev (ROS 2 Jazzy / C++ / learning)",
  "dockerComposeFile": [
    "../../compose.yaml",
    "../../compose.gui.yaml",
    "../compose.devcontainer.yaml"
  ],
  "service": "dev",
  "runServices": [
    "dev"
  ],
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",
  "updateRemoteUserUID": false,
  "shutdownAction": "none",
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "initializeCommand": "./scripts/lab prepare",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "charliermarsh.ruff",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}

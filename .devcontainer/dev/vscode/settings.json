{
  "python.defaultInterpreterPath": "/opt/learning-venv/bin/python",
  "python.terminal.activateEnvironment": false,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.extraPaths": [
    "/opt/ros/jazzy/lib/python3.12/site-packages"
  ],
  "python.analysis.exclude": [
    "**/__pycache__"
  ],
  "terminal.integrated.cwd": "${workspaceFolder}",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.configuration": "/opt/ruff/ruff.toml",
  "ruff.importStrategy": "fromEnvironment",
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/uv.lock": true
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**",
    "/opt/ros/jazzy/include/**"
  ],
  "cmake.useCMakePresets": "never",
  "cmake.configureOnOpen": true,
  "cmake.sourceDirectory": "/workspace/cppsrc",
  "cmake.buildDirectory": "/build/cppsrc/${buildType}",
  "cmake.generator": "Ninja",
  "cmake.buildBeforeRun": true,
  "cmake.defaultVariants": {
    "buildType": {
      "default": "debug",
      "description": "Build type",
      "choices": {
        "debug": {
          "short": "Debug",
          "long": "Debug symbols, no optimization",
          "buildType": "Debug"
        },
        "release": {
          "short": "Release",
          "long": "Optimized build",
          "buildType": "Release"
        }
      }
    }
  }
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: main (Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/build/cppsrc/Debug/bin/main",
      "args": [],
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${env:DEBUGGER}",
      "preLaunchTask": "C++: build (Debug)"
    },
    {
      "name": "Python learning: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "/opt/learning-venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "ROS: current Python node",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "/usr/bin/python3",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
